rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{userId} {
      // Full profile doc holds email + phone, so only the owner and
      // admins can read it. Everywhere else in the app (seller info on
      // listings, reviewer name) uses a denormalized copy, not this
      // doc, so this doesn't break anything else.
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      // Owner can edit their own profile, but NOT role or isBanned —
      // those fields must stay unchanged unless an admin is writing.
      // Without this, any signed-in user could set role:'admin' on
      // their own doc and self-promote, or clear isBanned to un-ban
      // themselves. Uses .get() with a default because some existing
      // accounts predate the isBanned field being written at signup —
      // a direct .isBanned access errors (and denies the whole write)
      // when the key is simply missing rather than false.
      allow update: if (isOwner(userId) &&
          request.resource.data.get('role', null) == resource.data.get('role', null) &&
          request.resource.data.get('isBanned', false) == resource.data.get('isBanned', false)) ||
        isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }

    match /listings/{listingId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin();
      // Anyone browsing (signed in or not) can bump the view counter —
      // used for the "Most Viewed" analytics stat. Scoped tightly so
      // this can never be abused to change price/stock/etc: only the
      // viewCount field may change, and only by exactly +1 per write.
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount']) &&
        request.resource.data.viewCount == resource.data.viewCount + 1;
      allow delete: if isAdmin();

      match /reviews/{userId} {
        allow read: if true;
        allow create: if isSignedIn() && request.auth.uid == userId;
        // Owner can edit their own review; admin can update too, so
        // they can attach a seller reply (adminReply/adminReplyAt)
        // without needing a separate collection just for replies.
        allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
        allow delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      }
    }

    // Collection-group counterpart of the reviews rule above — needed
    // separately because Firestore does not apply a nested subcollection
    // rule to collectionGroup() queries; it requires its own explicit
    // {path=**} match. Reviews are public read either way, so this just
    // mirrors that. Powers "My Reviews" on Profile (query across every
    // listing's reviews subcollection, filtered by userId).
    match /{path=**}/reviews/{reviewId} {
      allow read: if true;
    }

    match /cart/{userId}/items/{itemId} {
      allow read, write: if isOwner(userId);
    }

    match /addresses/{userId}/items/{addressId} {
      allow read, write: if isOwner(userId);
    }

    match /wishlist/{userId}/items/{itemId} {
      allow read, write: if isOwner(userId);
    }

    match /notifications/{userId}/items/{itemId} {
      allow read, update, delete: if isOwner(userId);
      allow create: if isAdmin();
    }

    match /orders/{orderId} {
      // Split into two rules (instead of one OR'd condition) so a
      // buyer's own list query — .where('buyerId', isEqualTo: uid) —
      // can be statically validated against the first rule alone.
      // Combining it with isAdmin() (a get()-based check) in a single
      // OR made Firestore unable to prove the query safe, so it denied
      // the whole list, not just the admin branch.
      allow read: if isSignedIn() && resource.data.buyerId == request.auth.uid;
      allow read: if isAdmin();
      // Orders are created ONLY by the placeOrder Cloud Function (Admin
      // SDK, which bypasses these rules) — never directly by the client.
      // A direct client write would let a buyer set item price/quantity
      // to whatever they want, since nothing here can check that against
      // the real listing price.
      allow create: if false;
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /trustScores/{userId} {
      allow read: if true;
      allow write: if false;
    }

    match /reports/{reportId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
